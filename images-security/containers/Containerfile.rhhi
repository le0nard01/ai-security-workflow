FROM registry.access.redhat.com/ubi9/openjdk-17:latest AS build
ARG MAVEN_PROFILE=none
WORKDIR /workspace
COPY app/pom.xml .
COPY app/src ./src
RUN if [ "$MAVEN_PROFILE" = unsafe ]; then mvn -B -Punsafe package -DskipTests; else mvn -B package -DskipTests; fi

# Minimal runtime: no shell or package manager. Same application bytes as other variants.
FROM registry.access.redhat.com/hi/openjdk:21-runtime
WORKDIR /work
COPY --from=build /workspace/target/quarkus-app/ /work/
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/work/quarkus-run.jar"]
